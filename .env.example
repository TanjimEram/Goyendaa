# Copy to .env.local for `npm run dev` / `npm run preview` (both gitignored).
#
# Both values are PUBLIC by design — they ship in the browser bundle. Row
# Level Security in Supabase is what protects data, not secrecy of these.
#
# Supabase dashboard → Project Settings → API (or "Data API").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key, or the newer "publishable" key (sb_publishable_…) — either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# No service-role key is needed. Admin writes run as the signed-in admin
# user through RLS; the public site reads as anon.
