# Copy to .dev.vars (gitignored). Read by `npm run preview` (wrangler) and,
# through the OpenNext dev bridge, by `npm run dev`. These are SECRETS or
# runtime settings — never NEXT_PUBLIC_, never in wrangler.jsonc.
#
# On Cloudflare: Worker → Settings → Variables and Secrets → add each as
# type "Secret" (encrypted). They are runtime values, not build variables.

# Supabase → Project Settings → API → service_role (secret). Bypasses RLS;
# used only in server code for order creation/lookup and signed downloads.
SUPABASE_SERVICE_ROLE_KEY=
# Your personal bKash number, exactly as buyers should type it, e.g. 01712345678
BKASH_NUMBER=
# Where new-order notifications go.
ADMIN_EMAIL=

# ONE email provider is enough. Brevo is the one that can reach real buyers
# without owning a domain: it verifies a single sender address (your Gmail)
# with a 6-digit code. Free tier 300/day. Brevo → SMTP & API → API Keys.
BREVO_API_KEY=

# Resend → API Keys. Only delivers to the Resend account owner until a
# domain is verified, so it's admin-alerts-only for now. Set BOTH and Brevo
# wins. With neither, sends are skipped and logged (fine for local testing).
RESEND_API_KEY=

# Shared secret between the Worker's cron trigger and /api/cron/solutions.
# Any long random string; generate one with:
#   node -e "console.log(crypto.randomUUID())"
# Without it the cron route refuses to run (fails closed).
CRON_SECRET=

# Sender, as "Name <address>". With Brevo this must be the address you
# verified there (goyendaaa@gmail.com). With Resend and no domain it must be
# onboarding@resend.dev.
EMAIL_FROM=Goyenda <goyendaaa@gmail.com>
