{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "Cloudflare Preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "Remotion Studio (reel-engine)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "F:/PP/Goyenda-Studio/reel-engine",
        "run",
        "dev",
        "--",
        "--port",
        "3010",
        "--no-open"
      ],
      "port": 3010
    }
  ]
}
