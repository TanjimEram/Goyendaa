// Cloudflare Workers config for the OpenNext build.
// Docs: https://opennext.js.org/cloudflare  ·  https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard exactly, or
  // wrangler warns and overrides it on every deploy. The live URL is
  // https://<name>.<account-subdomain>.workers.dev; the subdomain is an
  // account-level setting (Workers & Pages -> "Your subdomain"), not this file.
  "name": "goyenda",
  // Not .open-next/worker.js directly: custom-worker.ts re-exports OpenNext's
  // fetch handler and adds the scheduled() handler the cron trigger calls.
  "main": "custom-worker.ts",

  // nodejs_compat is required by OpenNext. The date pins workerd behaviour;
  // bump it deliberately, not as a side effect of other changes.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Prerendered HTML, /_next/static and /public are served as static assets —
  // free and uncapped on the Workers free plan. Only non-static requests hit
  // the Worker itself.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Deliberately NOT configured yet (each is a later, separate decision):
  //  - r2_buckets / NEXT_INC_CACHE_R2_BUCKET: ISR cache. Nothing uses ISR;
  //    every route is fully static. Add when a route needs revalidation.
  //  - images / IMAGES: Cloudflare Images transforms for next/image. Without
  //    it OpenNext serves the original file, which is fine until real case
  //    thumbnails exist. Free tier: 5,000 unique transforms/month.
  //  - services / WORKER_SELF_REFERENCE: only needed with the ISR cache.
  //  - vars / secrets: Supabase + Resend + payment keys go in as Worker
  //    secrets via the dashboard or `wrangler secret put`, never in this file.

  // Delayed solution emails. Every 10 minutes is well inside the 1-3 hour
  // rank delays, and the job is a no-op when nothing is due. Free plan
  // allows up to 5 cron triggers per account.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
